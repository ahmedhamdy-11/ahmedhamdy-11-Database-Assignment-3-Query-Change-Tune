<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT TOP (15)&#xa; i.InvoiceNumber,&#xa; sp.StudentNumber,&#xa; i.TotalAmount - i.PaidAmount AS Remaining,&#xa;CASE WHEN i.DueAtUtc &lt; DATEADD(DAY, -60, SYSUTCDATETIME()) THEN &apos;Urgent&apos; ELSE &apos;Normal&apos; END &#xa;AS Urgency&#xa;FROM finance.Invoices AS i&#xa;INNER JOIN [identity].StudentProfiles AS sp ON sp.Id = i.StudentId&#xa;WHERE i.PaidAmount &lt; i.TotalAmount&#xa;AND i.DueAtUtc &lt; SYSUTCDATETIME()&#xa;ORDER BY Remaining DESC" StatementId="1" StatementCompId="1" StatementType="SELECT" RetrievedFromCache="true" StatementSubTreeCost="2.80548" StatementEstRows="15" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xD484FABD4360370B" QueryPlanHash="0xDEC6F04DCB93853B" CardinalityEstimationModelVersion="150"><StatementSetOptions QUOTED_IDENTIFIER="false" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="8" MemoryGrant="11648" CachedPlanSize="56" CompileTime="27" CompileCPU="22" CompileMemory="600"><ThreadStat Branches="1" UsedThreads="8"><ThreadReservation NodeId="0" ReservedThreads="8"></ThreadReservation></ThreadStat><MissingIndexes><MissingIndexGroup Impact="57.351"><MissingIndex Database="[LmsTrainingLab]" Schema="[finance]" Table="[Invoices]"><ColumnGroup Usage="INEQUALITY"><Column Name="[DueAtUtc]" ColumnId="8"></Column></ColumnGroup><ColumnGroup Usage="INCLUDE"><Column Name="[InvoiceNumber]" ColumnId="2"></Column><Column Name="[StudentId]" ColumnId="3"></Column><Column Name="[TotalAmount]" ColumnId="9"></Column><Column Name="[PaidAmount]" ColumnId="10"></Column></ColumnGroup></MissingIndex></MissingIndexGroup></MissingIndexes><MemoryGrantInfo SerialRequiredMemory="512" SerialDesiredMemory="7248" RequiredMemory="4